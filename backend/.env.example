# Copier ce fichier en .env (jamais commité) puis adapter les valeurs.
PORT=4000
CORS_ORIGINS=http://localhost:3000

# PostgreSQL local (conteneur « db » lancé avec : docker compose up -d db)
# Doit correspondre à POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB du fichier .env racine.
DATABASE_URL=postgres://defenders:CHANGE_ME@localhost:5432/defenders_dev
# Base « fantôme » pour `prisma migrate dev` (créée une fois : CREATE DATABASE defenders_shadow;)
SHADOW_DATABASE_URL=postgres://defenders:CHANGE_ME@localhost:5432/defenders_shadow

# Durée d'une session admin (heures)
# Signature des jetons JWT : au moins 32 caractères aléatoires, différent par environnement.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_secret_aleatoire_de_32_caracteres_minimum
# Durée de validité d'une session / d'un JWT (heures)
SESSION_TTL_HOURS=12

# Premier admin, créé au démarrage si la table admins est vide
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_10_caracteres_min
ADMIN_NAME=Administrateur

# SMTP Gmail : créer un mot de passe d'application Google, ne jamais utiliser le mot de passe principal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-adresse@gmail.com
SMTP_PASS=mot_de_passe_d_application
CONTACT_TO=ahannachi193@gmail.com

# Adresse publique du site (liens dans les e-mails)
SITE_URL=http://localhost:3000
