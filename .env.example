# Variables lues par docker-compose.yml. Copier en .env (jamais commité) et changer les secrets.

# --- PostgreSQL ---
POSTGRES_USER=defenders
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=defenders_dev

# --- Premier compte admin (créé au premier démarrage du backend) ---
# Signature des jetons JWT du backend : au moins 32 caractères aléatoires.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_secret_aleatoire_de_32_caracteres_minimum

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_10_caracteres_min
ADMIN_NAME=Administrateur

# E-mail SMTP Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-adresse@gmail.com
SMTP_PASS=mot_de_passe_d_application
CONTACT_TO=ahannachi193@gmail.com
# Destinataire des demandes de devis DSP
SECURITY_CONTACT_TO=akkari-dsp@outlook.com
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Adresse publique du site (liens dans les e-mails)
SITE_URL=http://localhost:3001

# Nombre de reverse proxies de confiance devant le frontend (Nginx, Traefik…), 1 par défaut.
# Sert à lire la vraie IP du visiteur dans X-Forwarded-For pour le rate limit.
# En production, le proxy doit AJOUTER l'IP du client (Nginx : proxy_add_x_forwarded_for).
# TRUSTED_PROXY_HOPS=1

# Paiement de l'acompte en ligne (Konnect : carte bancaire, wallet, e-DINAR) — https://dashboard.konnect.network
# Sans clé : mode simulation en développement, paiement désactivé en production.
# Konnect appelle SITE_URL/paiement/retour : en production, SITE_URL doit être public et en HTTPS.
KONNECT_API_KEY=
KONNECT_WALLET_ID=
# Bac à sable par défaut ; production : https://api.konnect.network/api/v2
KONNECT_API_URL=https://api.sandbox.konnect.network/api/v2
